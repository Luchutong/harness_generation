{
  "schema_version": 1,
  "annotation_kind": "independent_manual_contract",
  "id": "repeated_feeds",
  "core_apis": [
    "mf_feed",
    "mf_finish"
  ],
  "required_support": [
    "mf_begin",
    "mf_end"
  ],
  "resources": [
    {
      "id": "parser",
      "origin": {
        "api": "mf_begin",
        "kind": "return",
        "parameter": null
      },
      "consumers": [
        {
          "api": "mf_feed",
          "parameter": "p"
        },
        {
          "api": "mf_finish",
          "parameter": "p"
        }
      ],
      "cleanup": "mf_end",
      "ownership": "owned",
      "scope": "per_input"
    }
  ],
  "input_binding": [
    {
      "api": "mf_feed",
      "parameter": "bytes",
      "source": "fuzz_data",
      "size_parameter": "length",
      "via_api": null
    },
    {
      "api": "mf_finish",
      "parameter": "p",
      "source": "context",
      "size_parameter": null,
      "via_api": "mf_feed"
    }
  ],
  "ownership": [
    {
      "api": "mf_begin",
      "parameter": null,
      "return_value": true,
      "ownership": "owned",
      "release_api": "mf_end"
    },
    {
      "api": "mf_feed",
      "parameter": "p",
      "return_value": false,
      "ownership": "borrowed",
      "release_api": null
    },
    {
      "api": "mf_finish",
      "parameter": "p",
      "return_value": false,
      "ownership": "borrowed",
      "release_api": null
    }
  ],
  "callback": [],
  "ordering": [
    {
      "before": "mf_begin",
      "after": "mf_feed"
    },
    {
      "before": "mf_feed",
      "after": "mf_finish"
    },
    {
      "before": "mf_finish",
      "after": "mf_end"
    }
  ],
  "invocation_counts": {
    "mf_feed": 2,
    "mf_finish": 1
  },
  "mandatory_constraints": {
    "feeds_cover_input_exactly_once": true
  },
  "adjudication": "strict necessary-contract checks; unknown is unverified, never automatically correct"
}
