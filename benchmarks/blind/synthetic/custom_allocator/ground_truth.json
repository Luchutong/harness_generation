{
  "schema_version": 1,
  "annotation_kind": "independent_manual_contract",
  "id": "custom_allocator",
  "core_apis": [
    "al_decode"
  ],
  "required_support": [
    "al_create",
    "al_destroy"
  ],
  "resources": [
    {
      "id": "parser",
      "origin": {
        "api": "al_create",
        "kind": "return",
        "parameter": null
      },
      "consumers": [
        {
          "api": "al_decode",
          "parameter": "p"
        }
      ],
      "cleanup": "al_destroy",
      "ownership": "owned",
      "scope": "per_input"
    }
  ],
  "input_binding": [
    {
      "api": "al_decode",
      "parameter": "data",
      "source": "fuzz_data",
      "size_parameter": "n",
      "via_api": null
    }
  ],
  "ownership": [
    {
      "api": "al_create",
      "parameter": null,
      "return_value": true,
      "ownership": "owned",
      "release_api": "al_destroy"
    },
    {
      "api": "al_decode",
      "parameter": "p",
      "return_value": false,
      "ownership": "borrowed",
      "release_api": null
    }
  ],
  "callback": [
    {
      "api": "al_create",
      "parameter": "arena.allocate",
      "kind": "allocator",
      "return_policy": "nonzero_allocated_storage"
    },
    {
      "api": "al_create",
      "parameter": "arena.release",
      "kind": "allocator_release",
      "return_policy": "void"
    }
  ],
  "ordering": [
    {
      "before": "al_create",
      "after": "al_decode"
    },
    {
      "before": "al_decode",
      "after": "al_destroy"
    }
  ],
  "invocation_counts": {},
  "mandatory_constraints": {
    "same_argument_storage": [
      {
        "left": [
          "al_create",
          "arena"
        ],
        "right": [
          "al_destroy",
          "arena"
        ]
      }
    ]
  },
  "adjudication": "strict necessary-contract checks; unknown is unverified, never automatically correct"
}
