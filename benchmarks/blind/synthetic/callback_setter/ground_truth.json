{
  "schema_version": 1,
  "annotation_kind": "independent_manual_contract",
  "id": "callback_setter",
  "core_apis": [
    "sc_parse"
  ],
  "required_support": [
    "sc_create",
    "sc_set_reader",
    "sc_destroy"
  ],
  "resources": [
    {
      "id": "parser",
      "origin": {
        "api": "sc_create",
        "kind": "return",
        "parameter": null
      },
      "consumers": [
        {
          "api": "sc_set_reader",
          "parameter": "p"
        },
        {
          "api": "sc_parse",
          "parameter": "p"
        }
      ],
      "cleanup": "sc_destroy",
      "ownership": "owned",
      "scope": "per_input"
    }
  ],
  "input_binding": [
    {
      "api": "sc_parse",
      "parameter": "data",
      "source": "fuzz_data",
      "size_parameter": "size",
      "via_api": null
    }
  ],
  "ownership": [
    {
      "api": "sc_create",
      "parameter": null,
      "return_value": true,
      "ownership": "owned",
      "release_api": "sc_destroy"
    },
    {
      "api": "sc_set_reader",
      "parameter": "p",
      "return_value": false,
      "ownership": "borrowed",
      "release_api": null
    },
    {
      "api": "sc_parse",
      "parameter": "p",
      "return_value": false,
      "ownership": "borrowed",
      "release_api": null
    }
  ],
  "callback": [
    {
      "api": "sc_parse",
      "parameter": "p.notify",
      "registration_api": "sc_set_reader",
      "kind": "notification",
      "return_policy": "zero_allowed"
    }
  ],
  "ordering": [
    {
      "before": "sc_create",
      "after": "sc_set_reader"
    },
    {
      "before": "sc_set_reader",
      "after": "sc_parse"
    },
    {
      "before": "sc_parse",
      "after": "sc_destroy"
    }
  ],
  "invocation_counts": {},
  "mandatory_constraints": {},
  "adjudication": "strict necessary-contract checks; unknown is unverified, never automatically correct"
}
