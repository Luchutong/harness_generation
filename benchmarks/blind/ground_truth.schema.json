{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blind independent contract annotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "annotation_kind",
    "id",
    "core_apis",
    "required_support",
    "resources",
    "input_binding",
    "ownership",
    "callback",
    "ordering",
    "invocation_counts",
    "mandatory_constraints",
    "adjudication"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "annotation_kind": {
      "const": "independent_manual_contract"
    },
    "id": {
      "type": "string"
    },
    "adjudication": {
      "type": "string"
    },
    "core_apis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "required_support": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "invocation_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "mandatory_constraints": {
      "type": "object"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "origin",
          "consumers",
          "cleanup",
          "ownership",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "origin": {
            "type": "object",
            "required": [
              "api",
              "kind",
              "parameter"
            ],
            "additionalProperties": false,
            "properties": {
              "api": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "return",
                  "out_parameter"
                ]
              },
              "parameter": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "api",
                "parameter"
              ],
              "properties": {
                "api": {
                  "type": "string"
                },
                "parameter": {
                  "type": "string"
                }
              }
            }
          },
          "cleanup": {
            "type": "string"
          },
          "ownership": {
            "enum": [
              "owned",
              "borrowed",
              "transferred",
              "static"
            ]
          },
          "scope": {
            "enum": [
              "per_input",
              "per_context",
              "static"
            ]
          }
        }
      }
    },
    "input_binding": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "api": {
            "type": "string"
          },
          "parameter": {
            "type": "string"
          },
          "source": {
            "enum": [
              "fuzz_data",
              "context",
              "callback"
            ]
          },
          "size_parameter": {
            "type": [
              "string",
              "null"
            ]
          },
          "via_api": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "api",
          "parameter",
          "source",
          "size_parameter",
          "via_api"
        ]
      }
    },
    "ownership": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "api": {
            "type": "string"
          },
          "parameter": {
            "type": [
              "string",
              "null"
            ]
          },
          "return_value": {
            "type": "boolean"
          },
          "ownership": {
            "enum": [
              "owned",
              "borrowed",
              "static",
              "transferred"
            ]
          },
          "release_api": {
            "type": [
              "string",
              "null"
            ]
          },
          "api_alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "api",
          "parameter",
          "return_value",
          "ownership",
          "release_api"
        ]
      }
    },
    "callback": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "api": {
            "type": "string"
          },
          "parameter": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "return_policy": {
            "type": "string"
          },
          "registration_api": {
            "type": "string"
          },
          "fuzz_input_required": {
            "type": "boolean"
          }
        },
        "required": [
          "api",
          "parameter",
          "kind",
          "return_policy"
        ]
      }
    },
    "ordering": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          }
        },
        "required": [
          "before",
          "after"
        ]
      }
    }
  }
}
