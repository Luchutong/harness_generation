__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
.env.*
!.env.example
runs/
build/
dist/

# Generated pipeline output is reproducible run data and is not part of the
# minimal demo source tree.
artifacts/

# Worktree metadata.  A git worktree living at .claude/worktrees/<name> is a
# checkout of its own branch; tracking it here would nest one repository's
# bookkeeping inside another.
.claude/worktrees/
